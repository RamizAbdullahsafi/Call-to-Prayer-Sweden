{
  "name": "call-to-prayer-sweden",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:assets && npm run icons",
    "build": "tsc && vite build",
    "validate:assets": "node scripts/validate-audio-assets.mjs",
    "validate:playstore": "node scripts/validate-playstore-readiness.mjs",
    "release:preflight": "npm run validate:assets && npm run validate:playstore && npm run build",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "azan-audio": "node scripts/fetch-azan-audio.mjs",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "android:sync": "npm run build && npx cap sync android",
    "android:copy": "npm run build && npx cap copy android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.3"
  }
}
